---
import type { SvgComponent } from "astro/types";

interface Props {
	
	title: string;
	description: string;
	source: ImageMetadata | SvgComponent;
} 

const { title, description, source: sourceImg } = Astro.props;
---

<div
  class="box-border flex h-75 w-full max-w-125 flex-col rounded-[18px] border-2 border-[#363636] bg-[#f7f7f7] p-6 text-[#b72626] shadow-[8px_8px_0_#363636] transition-[transform,box-shadow] duration-200 ease-in-out hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[10px_10px_0_#363636] font-['Inter','Segoe_UI',sans-serif]"
>
  <div class="mb-3">
	<h2 class="mb-3 m-0 text-[clamp(2.1rem,5vw,3rem)] leading-[0.9] tracking-[0.04em] uppercase text-[#b72626] font-['Bebas_Neue','Arial_Narrow',Arial,sans-serif]">{title}</h2>
	<p class="m-0 text-base leading-[1.6] text-[#b72626] font-['Bebas_Neue','Arial_Narrow',Arial,sans-serif]">{description}</p>
  </div>
  
<div
    class="mt-4 min-h-0 w-full flex-1 rounded-[10px] bg-contain bg-center bg-no-repeat"
    style={`background-image: url('${(sourceImg as ImageMetadata).src}')`}
></div>
</div>
<style>
	@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;700&display=swap');
</style>
