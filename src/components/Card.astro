---
const {
	title,
	description
} = Astro.props;
---

<div
  class="flex flex-col items-center justify-between gap-5 rounded-2xl bg-[#1B1C67]/60 p-6 font-sans shadow-md transition-all duration-300 hover:-translate-y-1 hover:bg-[#1B1C67]/95 hover:shadow-xl md:min-h-100 md:flex-row md:gap-10"
>
  <div class="flex flex-col gap-2">
	<h2 class="text-2xl font-bold text-[#B72626] md:text-3xl">{title}</h2>
	<p class="text-sm text-[#B72626] md:text-base">{description}</p>
  </div>
  <slot />
<style>
	@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;700&display=swap');

	.card {
		width: 100%;
		max-width: 500px;
		height: 300px;
		background: #f7f7f7;
		border: 2px solid #363636;
		border-radius: 18px;
		padding: 1.5rem;
		margin: 0;
		color: #b72626;
		box-shadow: 8px 8px 0 #363636;
		font-family: 'Inter', 'Segoe UI', sans-serif;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
		box-sizing: border-box;
	}

	.card:hover {
		transform: translate(-2px, -2px);
		box-shadow: 10px 10px 0 #363636;
	}

	.card-header {
		margin-bottom: 0.75rem;
	}

	.card-tag {
		display: inline-block;
		padding: 0.25rem 0.6rem;
		border: 1px solid #363636;
		border-radius: 999px;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-family: 'Bebas Neue', 'Arial Narrow', Arial, sans-serif;
	}

	h2 {
		margin: 0 0 0.75rem;
		font-size: clamp(2.1rem, 5vw, 3rem);
		line-height: 0.9;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #b72626;
		font-family: 'Bebas Neue', 'Arial Narrow', Arial, sans-serif;
	}

	p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.6;
        font-family: 'Bebas Neue', 'Arial Narrow', Arial, sans-serif;
		color: #b72626;
	}
</style>
