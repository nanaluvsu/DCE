---
const {
	title,
	description
} = Astro.props;
---

<article class="card">
	<!--  <div class="card-header">
		<span class="card-tag">DCE</span>
	</div> -->
	<h2>{title}</h2>
	<p>{description}</p>
</article>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;700&display=swap');

	.card {
		width: 100%;
		max-width: 500px;
		height: 300px;
		background: #f7f7f7;
		border: 2px solid #363636;
		border-radius: 18px;
		padding: 1.5rem;
		margin: 0;
		color: #b72626;
		box-shadow: 8px 8px 0 #363636;
		font-family: 'Inter', 'Segoe UI', sans-serif;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
		box-sizing: border-box;
	}

	.card:hover {
		transform: translate(-2px, -2px);
		box-shadow: 10px 10px 0 #363636;
	}

	.card-header {
		margin-bottom: 0.75rem;
	}

	.card-tag {
		display: inline-block;
		padding: 0.25rem 0.6rem;
		border: 1px solid #363636;
		border-radius: 999px;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-family: 'Bebas Neue', 'Arial Narrow', Arial, sans-serif;
	}

	h2 {
		margin: 0 0 0.75rem;
		font-size: clamp(2.1rem, 5vw, 3rem);
		line-height: 0.9;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #b72626;
		font-family: 'Bebas Neue', 'Arial Narrow', Arial, sans-serif;
	}

	p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.6;
        font-family: 'Bebas Neue', 'Arial Narrow', Arial, sans-serif;
		color: #b72626;
	}
</style>
